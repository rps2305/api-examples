# Copy this file to .env; never commit the real file.
EVENT_CALENDAR_SMTP_HOST=smtp.gmail.com
EVENT_CALENDAR_SMTP_PORT=465
EVENT_CALENDAR_SMTP_USERNAME=ronaldpunt.hengelo@gmail.com
EVENT_CALENDAR_FROM=ronaldpunt.hengelo@gmail.com
EVENT_CALENDAR_SMTP_PASSWORD=replace-with-a-gmail-app-password
EVENT_CALENDAR_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# The container is deliberately reachable only through CloudPanel/Nginx on localhost.
EVENT_CALENDAR_PORT=3480
EVENT_CALENDAR_SCHEDULE_ENABLED=true
